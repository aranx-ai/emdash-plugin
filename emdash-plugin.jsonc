{
    "$schema": "./node_modules/@emdash-cms/plugin-cli/schemas/emdash-plugin.schema.json",

    "slug": "aranx",
    "name": "Aranx",
    "description": "Aranx writes SEO blog articles. This plugin saves each one as an EmDash post with its image and categories, and publishes it on request.",
    "keywords": ["seo", "blog", "ai", "content", "aranx"],
    // The Aranx atproto account (handle aranx.com).
    "publisher": "did:web:pds.aranx.com",
    "repo": "https://github.com/aranx-ai/emdash-plugin",

    "license": "MIT",
    "author": { "name": "Aranx", "url": "https://aranx.com" },
    "security": { "email": "security@aranx.com" },

    // Changing the trust contract between releases needs a major version.
    "capabilities": [
        "network:request",
        "schema:read",
        "content:write",
        "content:publish",
        "taxonomies:write",
        "media:write"
    ],
    // The Aranx API and the image CDN. `*.aranx.com` also matches aranx.com.
    "allowedHosts": ["*.aranx.com"],
    "storage": {
        "articles": { "indexes": ["entryId"] }
    },

    // Listing images go on each release record. A release without them shows none.
    "release": {
        "artifacts": {
            "icon": { "file": "assets/icon.png" },
            "banner": { "file": "assets/banner.png" }
        }
    },

    "admin": {
        "pages": [{ "path": "/status", "label": "Aranx", "icon": "sparkles" }],
        "settingsSchema": {
            "apiKey": { "type": "secret", "label": "API key" },
            "webhookSecret": { "type": "secret", "label": "Webhook secret" },
            "collection": { "type": "string", "label": "Collection", "default": "posts" },
            "taxonomy": { "type": "string", "label": "Category taxonomy", "default": "category" },
            "apiBaseUrl": {
                "type": "url",
                "label": "API URL",
                "default": "https://aranx.com/api/v1/public"
            }
        }
    }
}
